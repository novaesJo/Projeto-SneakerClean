# ============================================================
#  SneakerClean - Exemplo de Variáveis de Ambiente
#  Copie este arquivo, renomeie para .env e preencha com seus dados reais.
# ============================================================

# --- Configurações do Servidor Flask ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=coloque-uma-chave-secreta-aqui

# --- Dados PIX (preencha com sua chave e nome) ---
PIX_KEY=sua_chave_pix_aqui
PIX_HOLDER=Seu Nome Completo Aqui

# --- Banco de Dados ---
DATABASE_NAME=tenis_cleaner.db
